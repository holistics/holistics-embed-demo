# Mercateam Embed Portal — credentials from the `mercateam_portal` Embed Portal in Holistics
# (eu.holistics.io → mercateam_portal → Embed settings). Copy this file to `.env` and fill in.
# `.env` is git-ignored — never commit real keys.
HOLISTICS_MERCATEAM_PORTAL_KEY=your_embed_code_here
HOLISTICS_MERCATEAM_PORTAL_SECRET=your_secret_key_here
